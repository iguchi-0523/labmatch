// ラボマッチ Prisma schema
// 詳細は docs/技術設計書.md を参照

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 大学・研究機関
//
// 階層構造（自己参照）：
//   - 親大学（東京大学）が複数の子センター（医科学研究所・UTokyo Hospital 等）を持つ
//   - 単独の研究機関（OIST / RIKEN）は parentId=null
//   - category は config/universities.json と整合（national/public/private/research-institute）
//
// 検索動作：
//   - 親大学を選択 → 親 + すべての子を含むラボがヒット
//   - 子センターのみ選択 → そのセンターのラボのみ
model University {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  prefecture String?
  parentId   Int?     @map("parent_id")
  category   String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt      @map("updated_at")

  parent          University?      @relation("UnivHierarchy", fields: [parentId], references: [id])
  children        University[]     @relation("UnivHierarchy")
  labs            Lab[]
  labAffiliations LabAffiliation[]

  @@map("universities")
}

// 研究室（= 主宰者の教授）
model Lab {
  id                   Int       @id @default(autoincrement())
  universityId         Int       @map("university_id")
  name                 String
  professorName        String    @map("professor_name")
  department           String?
  officialUrl          String?   @map("official_url")
  researcherNumber     String?   @unique @map("researcher_number") // e-Rad ID
  researchmapId        String?   @unique @map("researchmap_id")
  openalexAuthorId     String?   @unique @map("openalex_author_id")
  orcid                String?   @unique
  primaryFieldCode     String?   @map("primary_field_code")
  primaryFieldName     String?   @map("primary_field_name")
  aiSummary            String?   @map("ai_summary")
  aiSummaryGeneratedAt DateTime? @map("ai_summary_generated_at")
  aiSummarySourceHash  String?   @map("ai_summary_source_hash")
  tags                 String[]  @default([])
  tagsGeneratedAt      DateTime? @map("tags_generated_at")
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt      @map("updated_at")

  university   University    @relation(fields: [universityId], references: [id])
  works        Work[]
  grants       Grant[]
  labFields    LabField[]
  labSocieties LabSociety[]
  labReports   LabReport[]
  affiliations LabAffiliation[]

  @@index([universityId])
  @@index([deletedAt])
  @@map("labs")
}

// ラボと大学・研究機関の多対多関係（複数所属の研究者）。
//
// 例：橋本太郎先生が「東京大学」と「自治医科大学」の両方に cross-affiliation
//     している場合、Lab レコードは 1 件（先勝ちで universityId=東京大学）。
//     LabAffiliation は (lab=橋本研, university=東京大学, isPrimary=true) と
//     (lab=橋本研, university=自治医科大学, isPrimary=false) の 2 行を持つ。
//
// 検索は LabAffiliation 経由 → 東京大学でも自治医科大学でも橋本研がヒット。
// 表示は Lab.university（=主所属）+ 「兼任」リスト。
model LabAffiliation {
  labId        Int      @map("lab_id")
  universityId Int      @map("university_id")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  lab        Lab        @relation(fields: [labId], references: [id], onDelete: Cascade)
  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@id([labId, universityId])
  @@index([universityId])
  @@map("lab_affiliations")
}

// 研究成果（論文・著書など）
model Work {
  id          Int      @id @default(autoincrement())
  labId       Int      @map("lab_id")
  title       String
  titleJa     String?  @map("title_ja")
  abstract    String?
  hasAbstract Boolean  @default(false) @map("has_abstract")
  year        Int?
  doi         String?
  sourceUrl   String?  @map("source_url")
  type        String?  // "paper" | "book" | "other"
  createdAt   DateTime @default(now()) @map("created_at")

  lab Lab @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([labId])
  @@index([year])
  @@index([hasAbstract])
  @@map("works")
}

// 科研費課題
model Grant {
  id          Int       @id @default(autoincrement())
  labId       Int       @map("lab_id")
  title       String
  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")
  amount      Int?      // 円
  category    String?   // 審査区分
  kakenUrl    String?   @map("kaken_url")
  createdAt   DateTime  @default(now()) @map("created_at")

  lab Lab @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([labId])
  @@map("grants")
}

// 分野（科研費「審査区分」に基づく階層マスタ）
model Field {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  parentId  Int?     @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")

  parent    Field?     @relation("FieldHierarchy", fields: [parentId], references: [id])
  children  Field[]    @relation("FieldHierarchy")
  labFields LabField[]

  @@map("fields")
}

// Lab と Field の多対多
model LabField {
  labId   Int @map("lab_id")
  fieldId Int @map("field_id")

  lab   Lab   @relation(fields: [labId], references: [id], onDelete: Cascade)
  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([labId, fieldId])
  @@map("lab_fields")
}

// 学会（researchmap 依存のため MVP では空のことが多い）
model Society {
  id   Int    @id @default(autoincrement())
  name String @unique

  labSocieties LabSociety[]

  @@map("societies")
}

// Lab と Society（役職付き）
model LabSociety {
  labId     Int     @map("lab_id")
  societyId Int     @map("society_id")
  role      String? // 役職（例: "理事", "副会長"）

  lab     Lab     @relation(fields: [labId], references: [id], onDelete: Cascade)
  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@id([labId, societyId])
  @@map("lab_societies")
}

// 研究室の掲載に関する削除・修正依頼
// SLA: 72時間以内に一次返信。*.ac.jp ドメインからの依頼を優先処理。
model LabReport {
  id                  Int       @id @default(autoincrement())
  labId               Int       @map("lab_id")
  reporterEmail       String    @map("reporter_email")
  reporterEmailDomain String    @map("reporter_email_domain") // 優先処理判定用（"u-tokyo.ac.jp" 等）
  reporterAffiliation String?   @map("reporter_affiliation")  // 自由記入
  reason              String    // 依頼内容（自由記入）
  reportType          String    @default("removal") @map("report_type") // "removal" | "correction"
  status              String    @default("pending") // "pending" | "reviewing" | "removed" | "kept" | "corrected"
  resolutionNote      String?   @map("resolution_note") // スタッフ対応メモ
  createdAt           DateTime  @default(now()) @map("created_at")
  resolvedAt          DateTime? @map("resolved_at")

  lab Lab @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([labId])
  @@index([status])
  @@index([reporterEmailDomain])
  @@map("lab_reports")
}
